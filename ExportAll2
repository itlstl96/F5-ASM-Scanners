param (
    [Parameter(Mandatory = $true)]
    [string]$BigIPHost,

    [Parameter(Mandatory = $true)]
    [int]$Port,

    [Parameter(Mandatory = $true)]
    [string]$User
)

# -------------------------
# Authentication
# -------------------------
$Password = Read-Host -Prompt "Enter password for $User" -AsSecureString
$BSTR = [System.Runtime.InteropServices.Marshal]::SecureStringToBSTR($Password)
$PlainPassword = [System.Runtime.InteropServices.Marshal]::PtrToStringAuto($BSTR)
[System.Runtime.InteropServices.Marshal]::ZeroFreeBSTR($BSTR)

[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
[Net.ServicePointManager]::ServerCertificateValidationCallback = { $true }

$BaseUrl = "https://$BigIPHost`:$Port"
$VSUrl   = "$BaseUrl/mgmt/tm/ltm/virtual"

$AuthHeader = [Convert]::ToBase64String(
    [Text.Encoding]::ASCII.GetBytes("$User`:$PlainPassword")
)
$Headers = @{ Authorization = "Basic $AuthHeader" }

# -------------------------
# Config
# -------------------------
$ExcludedAsmHostnamePolicies = @("Copie3","PolicyZ")
$importanceOrder = @("Critic","Important","Mediu","Non-Prod")

# -------------------------
# Generic GET
# -------------------------
function Invoke-BigIPGet {
    param ($Url)
    try {
        $req = [System.Net.HttpWebRequest]::Create($Url)
        $req.Method = "GET"
        $req.Headers["Authorization"] = $Headers.Authorization
        $req.Accept = "application/json"
        $resp = $req.GetResponse()
        $reader = New-Object IO.StreamReader($resp.GetResponseStream())
        $reader.ReadToEnd() | ConvertFrom-Json
    } catch {
        $null
    }
}

# -------------------------
# Pool members
# -------------------------
function Get-NodesFromVS {
    param ($vs)

    if (-not $vs.poolReference.link) {
        return @(@{ address=""; name="" })
    }

    $pool = Invoke-BigIPGet ($vs.poolReference.link -replace "https://localhost", $BaseUrl)
    if (-not $pool.membersReference.link) {
        return @(@{ address=""; name="" })
    }

    (Invoke-BigIPGet ($pool.membersReference.link -replace "https://localhost", $BaseUrl)).items
}

# -------------------------
# LTM rule conditions (REFINED)
# -------------------------
function Get-LtmRuleConditions {
    param (
        [string]$PolicyPartition,
        [string]$PolicyName,
        [string]$RuleName
    )

    $url = "$BaseUrl/mgmt/tm/ltm/policy/~$PolicyPartition~$PolicyName/rules/$RuleName/conditions"
    $data = Invoke-BigIPGet $url

    if (-not $data.items) { return "*" }

    $out = @()

    foreach ($c in $data.items) {

        # HTTP Host (always equality in practice)
        if ($c.httpHost -eq $true -and $c.values) {
            $out += "host == (" + ($c.values -join ",") + ")"
        }

        # HTTP URI
        if ($c.httpUri -eq $true -and $c.values) {

            if ($c.equals -eq $true) {
                $out += "uri == (" + ($c.values -join ",") + ")"
            }
            elseif ($c.startsWith -eq $true) {
                # normalize startsWith to wildcard syntax
                $vals = $c.values | ForEach-Object { "$_*" }
                $out += "uri == (" + ($vals -join ",") + ")"
            }
        }
    }

    if ($out.Count -eq 0) { return "*" }
    $out -join " && "
}

# -------------------------
# ASM policies + hostname cache
# -------------------------
$asmPolicies = @{}
$asmData = Invoke-BigIPGet "$BaseUrl/mgmt/tm/asm/policies/"
foreach ($p in $asmData.items) {
    $asmPolicies[$p.name] = $p.id
}

$asmHostCache = @{}

function Get-AsmHostNames {
    param ($PolicyName)

    if ($asmHostCache.ContainsKey($PolicyName)) {
        return $asmHostCache[$PolicyName]
    }

    if (-not $asmPolicies.ContainsKey($PolicyName)) {
        $asmHostCache[$PolicyName] = @()
        return @()
    }

    $id = $asmPolicies[$PolicyName]
    $hosts = @()

    $data = Invoke-BigIPGet "$BaseUrl/mgmt/tm/asm/policies/$id/host-names"
    foreach ($h in $data.items) {
        if ($h.name) { $hosts += $h.name }
    }

    $asmHostCache[$PolicyName] = $hosts
    $hosts
}

# -------------------------
# DoS profiles
# -------------------------
$dosProfiles = @{}
$dosData = Invoke-BigIPGet "$BaseUrl/mgmt/tm/security/dos/profile"
foreach ($d in $dosData.items) {
    $dosProfiles[$d.name] = $d.fullPath
}

# -------------------------
# Get Virtual Servers
# -------------------------
$data = Invoke-BigIPGet $VSUrl
if (-not $data.items) {
    Write-Host "No virtual servers found."
    exit 1
}

# -------------------------
# MAIN
# -------------------------
$csvData = foreach ($vs in $data.items) {

    # VS IP / Port
    $vsIP = ""; $vsPort = ""
    if ($vs.destination -match '^(.*):(\d+)$') {
        $vsIP = ($matches[1] -replace '^/[^/]+/','')
        $vsPort = $matches[2]
    }

    # Description tags
    $vsImportance = ""
    $ipPublic = ""
    $itOwner = ""
    $businessOwner = ""
    $waap = ""

    if ($vs.description) {
        if ($vs.description -match '\[utilizare\]:\[(.*?)\]') { $vsImportance = $matches[1] }
        if ($vs.description -match '\[ip_public\]:\[(.*?)\]') { $ipPublic = $matches[1] }
        if ($vs.description -match '\[it_owner\]:\[(.*?)\]') { $itOwner = $matches[1] }
        if ($vs.description -match '\[business_owner\]:\[(.*?)\]') { $businessOwner = $matches[1] }
        if ($vs.description -match '\[waap\]:\[(.*?)\]') { $waap = $matches[1] }
    }

    $members = Get-NodesFromVS $vs
    $rows = @()

    # -------------------------
    # Direct profiles
    # -------------------------
    $directAsm = @()
    $directDos = @()

    $profiles = Invoke-BigIPGet "$BaseUrl/mgmt/tm/ltm/virtual/~$($vs.partition)~$($vs.name)/profiles/"
    foreach ($p in $profiles.items) {
        $asmName = $p.name -replace '^ASM_', ''
        if ($asmPolicies.ContainsKey($asmName)) { $directAsm += $asmName }
        elseif ($dosProfiles.ContainsKey($p.name)) { $directDos += $p.name }
    }

    if ($directAsm -or $directDos) {

        $hostNames = @()
        foreach ($a in $directAsm) {
            if ($ExcludedAsmHostnamePolicies -notcontains $a) {
                $hostNames += Get-AsmHostNames $a
            }
        }

        $rows += [PSCustomObject]@{
            Condition             = "*"
            ASM_Policies          = ($directAsm | Sort-Object -Unique) -join ';'
            DOS_Policies          = ($directDos | Sort-Object -Unique) -join ';'
            ASM_Allowed_Hostnames = ($hostNames | Sort-Object -Unique) -join ';'
        }
    }

    # -------------------------
    # LTM policy rules
    # -------------------------
    $policies = Invoke-BigIPGet "$BaseUrl/mgmt/tm/ltm/virtual/~$($vs.partition)~$($vs.name)/policies/"

    foreach ($pol in $policies.items) {

        if ($pol.name -match '^asm_auto_l7_') { continue }

        $rules = Invoke-BigIPGet "$BaseUrl/mgmt/tm/ltm/policy/~$($pol.partition)~$($pol.name)/rules"

        foreach ($r in $rules.items) {

            $asmForRule = @()
            $dosForRule = @()

            $actions = Invoke-BigIPGet ($r.actionsReference.link -replace "https://localhost", $BaseUrl)

            foreach ($a in $actions.items) {
                if ($a.asm -eq $true -and $a.policy) {
                    $asmForRule += ($a.policy -split '/')[-1]
                }
                if ($a.l7dos -eq $true -and $a.fromProfile) {
                    $dosForRule += ($a.fromProfile -split '/')[-1]
                }
            }

            if ($asmForRule -or $dosForRule) {

                $hostNames = @()
                foreach ($a in $asmForRule) {
                    if ($ExcludedAsmHostnamePolicies -notcontains $a) {
                        $hostNames += Get-AsmHostNames $a
                    }
                }

                $rows += [PSCustomObject]@{
                    Condition             = Get-LtmRuleConditions `
                                              -PolicyPartition $pol.partition `
                                              -PolicyName $pol.name `
                                              -RuleName $r.name
                    ASM_Policies          = ($asmForRule | Sort-Object -Unique) -join ';'
                    DOS_Policies          = ($dosForRule | Sort-Object -Unique) -join ';'
                    ASM_Allowed_Hostnames = ($hostNames | Sort-Object -Unique) -join ';'
                }
            }
        }
    }

    # -------------------------
    # Emit CSV rows
    # -------------------------
    foreach ($row in $rows) {
        foreach ($m in $members) {

            [PSCustomObject]@{
                VS_Importance         = $vsImportance
                It_owner              = $itOwner
                Business_owner        = $businessOwner
                WAAP                  = $waap
                Condition             = $row.Condition
                ASM_Allowed_Hostnames = $row.ASM_Allowed_Hostnames
                VS_Name               = $vs.name
                IP_Public             = $ipPublic
                VS_IP                 = $vsIP
                VS_Port               = $vsPort
                Node_IP               = $m.address
                Node_Port             = ($m.name -replace '.*:','')
                ASM_Policies          = $row.ASM_Policies
                DOS_Policies          = $row.DOS_Policies
            }
        }
    }
}

# -------------------------
# Export
# -------------------------
$csvData |
    Sort-Object @{ Expression = { [array]::IndexOf($importanceOrder, $_.VS_Importance) } } |
    Export-Csv "BIGIP_VS_Conditions.csv" -NoTypeInformation -Encoding UTF8

Write-Host "Export completed: BIGIP_VS_Conditions.csv"
