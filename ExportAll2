param (
    [Parameter(Mandatory = $true)]
    [string]$BigIPHost,

    [Parameter(Mandatory = $true)]
    [int]$Port,

    [Parameter(Mandatory = $true)]
    [string]$User
)

# -------------------------
# Authentication
# -------------------------
$Password = Read-Host -Prompt "Enter password for $User" -AsSecureString
$BSTR = [System.Runtime.InteropServices.Marshal]::SecureStringToBSTR($Password)
$PlainPassword = [System.Runtime.InteropServices.Marshal]::PtrToStringAuto($BSTR)
[System.Runtime.InteropServices.Marshal]::ZeroFreeBSTR($BSTR)

[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
[Net.ServicePointManager]::ServerCertificateValidationCallback = { $true }

$BaseUrl = "https://$BigIPHost`:$Port"
$VSUrl   = "$BaseUrl/mgmt/tm/ltm/virtual"

$AuthHeader = [Convert]::ToBase64String(
    [Text.Encoding]::ASCII.GetBytes("$User`:$PlainPassword")
)
$Headers = @{ Authorization = "Basic $AuthHeader" }

# -------------------------
# Generic GET
# -------------------------
function Invoke-BigIPGet {
    param ($Url)
    try {
        $req = [System.Net.HttpWebRequest]::Create($Url)
        $req.Method = "GET"
        $req.Headers["Authorization"] = $Headers.Authorization
        $req.Accept = "application/json"

        $resp = $req.GetResponse()
        $reader = New-Object IO.StreamReader($resp.GetResponseStream())
        $reader.ReadToEnd() | ConvertFrom-Json
    }
    catch {
        $null
    }
}

# -------------------------
# Get nodes from VS
# -------------------------
function Get-NodesFromVS {
    param ($vs)

    if (-not $vs.poolReference?.link) { return @() }

    $pool = Invoke-BigIPGet ($vs.poolReference.link -replace "https://localhost", $BaseUrl)
    if (-not $pool.membersReference?.link) { return @() }

    $members = Invoke-BigIPGet ($pool.membersReference.link -replace "https://localhost", $BaseUrl)
    return $members.items ?? @()
}

# -------------------------
# ASM policies
# -------------------------
$asmPolicies = @{}
$asmData = Invoke-BigIPGet "$BaseUrl/mgmt/tm/asm/policies"
foreach ($p in $asmData.items) {
    $asmPolicies[$p.name] = $true
}

# -------------------------
# DoS profiles
# -------------------------
$dosProfiles = @{}
$dosData = Invoke-BigIPGet "$BaseUrl/mgmt/tm/security/dos/profile"
foreach ($d in $dosData.items) {
    $dosProfiles[$d.name] = $true
}

# -------------------------
# Virtual Servers
# -------------------------
$vsData = Invoke-BigIPGet $VSUrl
if (-not $vsData.items) { exit 1 }

$csvData = foreach ($vs in $vsData.items) {

    # VS IP / Port
    $vsIP = ""
    $vsPort = ""
    if ($vs.destination -match '^/[^/]+/(.+):(\d+)$') {
        $vsIP = $matches[1]
        $vsPort = $matches[2]
    }

    # Metadata from description
    $vsImportance = ""
    $ipPublic = ""
    $itOwner = ""
    $businessOwner = ""

    if ($vs.description) {
        if ($vs.description -match '\[utilizare\]:\[(.*?)\]') { $vsImportance = $matches[1] }
        if ($vs.description -match '\[ip_public\]:\[(.*?)\]') { $ipPublic = $matches[1] }
        if ($vs.description -match '\[it_owner\]:\[(.*?)\]') { $itOwner = $matches[1] }
        if ($vs.description -match '\[business_owner\]:\[(.*?)\]') { $businessOwner = $matches[1] }
    }

    # Pool members
    $members = Get-NodesFromVS $vs
    if (-not $members) { $members = @(@{ address=""; name="" }) }

    # -------------------------
    # Profiles on VS
    # -------------------------
    $asmList = @()
    $dosList = @()

    $profiles = Invoke-BigIPGet (
        "$BaseUrl/mgmt/tm/ltm/virtual/~$($vs.partition)~$($vs.name)/profiles"
    )

    foreach ($p in $profiles.items) {
        $norm = $p.name -replace '^ASM_', ''
        if ($asmPolicies.ContainsKey($norm)) { $asmList += $norm }
        if ($dosProfiles.ContainsKey($p.name)) { $dosList += $p.name }
    }

    # -------------------------
    # LTM policies (FIXED)
    # -------------------------
    $policies = Invoke-BigIPGet (
        "$BaseUrl/mgmt/tm/ltm/virtual/~$($vs.partition)~$($vs.name)/policies"
    )

    foreach ($pol in $policies.items) {

        if ($pol.name -match '^asm_auto_l7_') { continue }

        $rules = Invoke-BigIPGet (
            "$BaseUrl/mgmt/tm/ltm/policy/~$($pol.partition)~$($pol.name)/rules"
        )

        foreach ($r in $rules.items) {

            if (-not $r.actionsReference?.link) { continue }

            $actions = Invoke-BigIPGet (
                $r.actionsReference.link -replace "https://localhost", $BaseUrl
            )

            foreach ($a in $actions.items) {

                # ASM via LTM
                if ($a.asm -eq $true -and $a.policy) {
                    $asmName = ($a.policy -split '/')[-1]
                    if (-not $asmList.Contains($asmName)) {
                        $asmList += $asmName
                    }
                }

                # DoS L7 via LTM (CRITICAL FIX)
                if ($a.dos -eq $true -and $a.fromProfile) {
                    $dosName = ($a.fromProfile -split '/')[-1]
                    if (-not $dosList.Contains($dosName)) {
                        $dosList += $dosName
                    }
                }
            }
        }
    }

    $asmList = ($asmList | Sort-Object -Unique | Where-Object { $_ -ne "websecurity" }) -join ';'
    $dosList = ($dosList | Sort-Object -Unique) -join ';'

    foreach ($m in $members) {
        [PSCustomObject]@{
            VS_Importance   = $vsImportance
            It_owner        = $itOwner
            Business_owner  = $businessOwner
            VS_Name         = $vs.name
            IP_Public       = $ipPublic
            VS_IP           = $vsIP
            VS_Port         = $vsPort
            Node_IP         = $m.address
            Node_Port       = ($m.name -match ':(\d+)$') ? $matches[1] : ""
            ASM_Policies    = $asmList
            DOS_Policies    = $dosList
        }
    }
}

# -------------------------
# Export
# -------------------------
$csvData | Export-Csv "BIGIP_VS_Nodes.csv" -NoTypeInformation -Encoding UTF8
Write-Host "Export completed: BIGIP_VS_Nodes.csv"
